# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e
# Tags document the intended upstream release; digests make rebuilds reproducible.
ARG BUN_IMAGE=oven/bun:1.3-slim@sha256:d56a2534ffd262e92c12fd3249d3924d296d97086da773f821d7d0477435ea04
ARG NGINX_IMAGE=nginxinc/nginx-unprivileged:1.27-bookworm@sha256:f9dfa9c20b2b0b7c5cc830374f22f23dee3f750b6c5291ca7e0330b5c88e6403

# ---------- build ----------
FROM ${BUN_IMAGE} AS build
WORKDIR /app

# Vite substitutes OIDC configuration at build time. Keep these explicit build
# arguments: setting only the runtime container environment would leave the
# shipped static bundle with authentication disabled.
ARG VITE_OIDC_ISSUER
ARG VITE_OIDC_CLIENT_ID=nisaba-web
ARG VITE_OIDC_SCOPE="openid profile email"
ENV VITE_OIDC_ISSUER=${VITE_OIDC_ISSUER} \
    VITE_OIDC_CLIENT_ID=${VITE_OIDC_CLIENT_ID} \
    VITE_OIDC_SCOPE=${VITE_OIDC_SCOPE}
RUN test -n "$VITE_OIDC_ISSUER" && test -n "$VITE_OIDC_CLIENT_ID"

# Workspace root: copy all workspace member manifests + lockfile for install.
COPY package.json bun.lock tsconfig.base.json ./
COPY web/package.json web/tsconfig.json web/
# Dependency patches must exist before the (explicit) postinstall applies them.
COPY web/patches web/patches
COPY tools/package.json tools/tsconfig.json tools/
RUN bun install --frozen-lockfile
# bun skips root lifecycle scripts when the lockfile is unchanged, so the
# loro-codemirror fix (patches/loro-codemirror+0.3.3.patch — the import handler
# used to abort on the first non-text event, blanking the editor after a review
# snapshot) must be applied explicitly.
RUN cd web && bun run postinstall

# Copy the web source for the build.
COPY web/ web/
RUN cd web && bun run build

# ---------- runtime ----------
FROM ${NGINX_IMAGE} AS runtime
LABEL org.opencontainers.image.title="nisaba-web" \
      org.opencontainers.image.source="https://github.com/sims1253/nisaba" \
      org.opencontainers.image.licenses="AGPL-3.0-only"

USER root
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl \
 && rm -rf /var/lib/apt/lists/*
USER 101

COPY deploy/web/nginx.conf /etc/nginx/conf.d/default.conf
COPY deploy/web/nginx-security-headers.conf /etc/nginx/security-headers.conf
COPY --from=build /app/web/dist /usr/share/nginx/html

EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -fsS "http://127.0.0.1:8080/healthz" || exit 1
