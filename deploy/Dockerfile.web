# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e
# Tags document the intended upstream release; digests make rebuilds reproducible.
ARG BUN_IMAGE=oven/bun:1.3-slim@sha256:d56a2534ffd262e92c12fd3249d3924d296d97086da773f821d7d0477435ea04
ARG NGINX_IMAGE=nginxinc/nginx-unprivileged:1.27-bookworm@sha256:f9dfa9c20b2b0b7c5cc830374f22f23dee3f750b6c5291ca7e0330b5c88e6403

# ---------- build ----------
FROM ${BUN_IMAGE} AS build
WORKDIR /app

# Workspace root: copy all workspace member manifests + lockfile for install.
COPY package.json bun.lock tsconfig.base.json ./
COPY web/package.json web/tsconfig.json web/
COPY tools/package.json tools/tsconfig.json tools/
RUN bun install --frozen-lockfile

# Copy the web source for the build.
COPY web/ web/
RUN cd web && bun run build

# ---------- runtime ----------
FROM ${NGINX_IMAGE} AS runtime
LABEL org.opencontainers.image.title="nisaba-web" \
      org.opencontainers.image.source="https://github.com/sims1253/nisaba" \
      org.opencontainers.image.licenses="AGPL-3.0-only"

USER root
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl \
 && rm -rf /var/lib/apt/lists/*
USER 101

COPY deploy/web/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/web/dist /usr/share/nginx/html

EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -fsS "http://127.0.0.1:8080/healthz" || exit 1
