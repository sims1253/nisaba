# =============================================================================
# Nisaba — local development environment template
# =============================================================================
# Copy to `.env` (never commit the real one) and adjust values.
# Every value below is a *local dev* default. None of these secrets are real.
# For production overrides see docs/operations.md and docs/security.md.
#
# The Docker Compose stack reads these variables. Application services read the
# `NISABA_*` variables via their own config layer (owned by the service streams).
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL  (shared instance; least-privilege roles created by the init script)
# -----------------------------------------------------------------------------
# `postgres` is the maintenance superuser used only for bootstrap/migrations.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=postgres
# Host-side port (bound to 127.0.0.1 only). 5433 avoids clashing with host PG.
POSTGRES_HOST_PORT=5433

# Dedicated, least-privilege role + database for the Nisaba `app` service.
# Created by deploy/postgres/init/10-init-databases.sh
NISABA_DB_USER=nisaba_app
NISABA_DB_PASSWORD=change-me-nisaba-app
NISABA_DB_NAME=nisaba
# NOTE: there is deliberately no DATABASE_URL here. It used to duplicate
# NISABA_DB_PASSWORD inside a literal connection string, and editing one but
# not the other surfaced as a confusing app auth failure. Consumers now build
# the URL from the parts above: docker-compose.yml synthesises the
# container-facing URL for the app service, and the justfile `migrate` recipe
# synthesises the host-facing one (127.0.0.1:${POSTGRES_HOST_PORT}) for sqlx.

# Dedicated role + database for Keycloak.
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-me-keycloak

# -----------------------------------------------------------------------------
# SeaweedFS  (S3-compatible object storage)
# -----------------------------------------------------------------------------
# Replaces the archived MinIO (minio/minio on GitHub is archived as of 2026-04).
# SeaweedFS identities (access keys, secrets, actions) are GENERATED at seaweedfs
# container start from the variables below (deploy/seaweedfs/generate-s3-identities.sh);
# no credentials are committed to the repo. The init-buckets sidecar uses the
# admin creds only to create buckets and enable versioning. Change both secrets
# for any non-local use (they take effect on the next container start).
NISABA_S3_ADMIN_KEY=nisaba-admin
NISABA_S3_ADMIN_SECRET=change-me-admin-secret
# Host-side S3 port (127.0.0.1 only).
SEAWEEDFS_HOST_S3_PORT=9100

# Application credentials (the nisaba-app S3 identity generated at startup).
NISABA_S3_ACCESS_KEY=nisaba-app
NISABA_S3_SECRET_KEY=change-me-s3-secret
# Endpoint as seen *from inside* the Docker network.
NISABA_S3_ENDPOINT=http://seaweedfs:8333
NISABA_S3_REGION=local
# Buckets created on first boot (object keys are opaque ids, never citation
# numbers — see docs/architecture.md §3). nisaba-oplog holds the sync
# service's durable CRDT history (oplog/ + snapshot/ key prefixes).
NISABA_S3_BUCKET_BLOBS=nisaba-blobs
NISABA_S3_BUCKET_OPLOG=nisaba-oplog

# -----------------------------------------------------------------------------
# Keycloak  (OIDC provider)
# -----------------------------------------------------------------------------
# Initial admin console account (http://127.0.0.1:8090/admin).
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin
KEYCLOAK_HTTP_PORT=8090
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.0@sha256:09a381c715ab0b111835b70f2905955274843a219c6f27efb348e4d9f4086858

# OIDC client used by the Nisaba web app. The `nisaba-web` client in
# deploy/keycloak/nisaba-realm.json is a PUBLIC client using the authorization
# code flow with PKCE (S256). No client secret is exposed to the browser, so
# none is configured here (and none is read by the app service).
NISABA_OIDC_CLIENT_ID=nisaba-web
# Issuer as it appears inside issued tokens (browser-facing). The app validates
# the `iss` claim against this value. Must match Keycloak's KC_HOSTNAME
# (localhost by default) exactly, or token validation will reject the issuer.
NISABA_OIDC_ISSUER=http://localhost:8090/realms/nisaba
# Token audience the app validates (the `aud` claim). The code and compose
# default is "nisaba"; this template sets "nisaba-web" to match the realm's
# `nisaba-audience` mapper, which emits this value into access tokens — do not
# change one without the other.
NISABA_OIDC_AUDIENCE=nisaba-web
# JWKS the app uses to verify token signatures, INLINE as JSON at startup. The
# app does NOT fetch a discovery URL today — it reads this variable directly.
# Leave empty for the safe deny-all default (no signing keys → every token is
# rejected). To accept tokens, populate it with a JWKS document whose `kid`
# values match the tokens' signing keys, e.g. for local dev against Keycloak:
#   curl -fsS http://127.0.0.1:8090/realms/nisaba/protocol/openid-connect/certs
# or use the self-contained dev token:  uv run deploy/dev-token.py
# In production the app adapter will fetch NISABA_OIDC_DISCOVERY_URL's JWKS.
NISABA_OIDC_JWKS_JSON=
# Discovery/JWKS endpoint reachable *from the app container* (internal DNS).
# Today the app reads NISABA_OIDC_JWKS_JSON inline; this URL is the production
# adapter's JWKS fetch target. In local dev the browser-facing issuer
# (localhost) and the container-facing resolver differ; behind one TLS hostname
# they collapse. See deploy/keycloak/README.md "Issuer split" and
# docs/operations.md §5.
NISABA_OIDC_DISCOVERY_URL=http://keycloak:8090/realms/nisaba
# Role names are NOT configurable: the author | reviewer | read-only vocabulary
# is hardcoded in crates/nisaba-auth and read from the access token's top-level
# `roles` claim, emitted by the realm's `realm-roles` mapper (the app reads
# `roles`, NOT `realm_access.roles`; see docs/security.md §2). There are
# deliberately no NISABA_OIDC_ROLE_* variables — setting them would have no
# effect.

# ----------------------------------------------------------------------------
# Application services  (built from deploy/Dockerfile.* ; brought up with the
# `app` profile:  `docker compose --profile app up`)
# -----------------------------------------------------------------------------
# The app always uses PostgreSQL and S3-compatible storage, including in local
# development. Test-only in-memory adapters are not compiled into the service binary.
# Internal port is fixed at 8080 for every Rust service (the aligned contract —
# see docker-compose.yml). Only the *host*-side port is configurable here, and
# every one binds to 127.0.0.1 only.
APP_HOST_PORT=8100
SYNC_HOST_PORT=8101
# compile has NO published host port: it is internal-only (svc-net), reachable
# solely by the app container at compile:8080. It is never exposed publicly.
# Built web container (nginx). Vite dev server runs on :5173 via `just web-dev`.
WEB_HOST_PORT=8103

# Shared secret authorising app → compile calls over svc-net. Injected into the
# app and compile containers ONLY (never sync/web/public). compile must enforce
# it on POST /compile; app must send it. Change for any non-local use.
NISABA_COMPILE_TOKEN=change-me-compile-token
# compile URL as the app container sees it (Docker DNS on svc-net).
NISABA_COMPILE_URL=http://compile:8080

# sync dev toggle: when set, every non-empty token is granted `author`,
# overriding the JWT/JWKS validation configured below. UNSET (the default here)
# keeps that validation active. NEVER use in production.
# NISABA_SYNC_DEV_ALLOW_ALL=1

# sync durable-store backend. docker-compose.yml pins `s3` (the op-log and
# snapshots live in the NISABA_S3_BUCKET_OPLOG bucket in SeaweedFS), so this
# is NOT read in the compose stack — it is the knob for bare-metal/dev runs
# of the binary outside compose: `fs` (default) keeps them on a local data
# dir (NISABA_SYNC_DATA_DIR), `s3` needs the NISABA_S3_* variables above.
#NISABA_SYNC_STORE_BACKEND=s3

# sync OIDC mode. All three are SET here so the local stack validates real
# Keycloak JWTs — required for the README quickstart's collaborative editing:
# sync verifies each token (iss/aud/signature via JWKS_URL), then asks the app
# (NISABA_SYNC_AUTHZ_URL below) to authorize the document. UNSETTING ALL THREE
# switches sync to deny-all (every handshake rejected) — the fail-closed mode
# deploy/e2e-app.sh asserts by stripping these three lines from its throwaway
# env. A partial set is a fatal startup error, never a silent deny-all. See
# services/sync/README.md "Authentication & authorization" for the full
# variable list and the wire contract the app service must implement
# server-side.
#   ISSUER  must equal the `iss` claim in issued tokens (== NISABA_OIDC_ISSUER).
#   JWKS_URL is the certs endpoint reachable *from the sync container*
#           (Docker DNS, like NISABA_OIDC_DISCOVERY_URL).
NISABA_SYNC_OIDC_ISSUER=http://localhost:8090/realms/nisaba
NISABA_SYNC_OIDC_AUDIENCE=nisaba-web
NISABA_SYNC_OIDC_JWKS_URL=http://keycloak:8090/realms/nisaba/protocol/openid-connect/certs
# Roles claim path in the JWT. The dev realm's mapper emits a top-level "roles"
# claim (not the nested "realm_access.roles" that is the sync default).
NISABA_SYNC_OIDC_ROLES_CLAIM=roles
# Per-document verifier (the app endpoint). The same machine credential is
# injected into app and sync only; it is never exposed to web or the browser.
NISABA_SYNC_AUTHZ_URL=http://app:8080/internal/sync/authorize
NISABA_SYNC_AUTHZ_TOKEN=change-me-sync-authz-token
# Sync service base URL for the app's export-time review-state reads
# (GET /internal/docs/{id}/state), authenticated with the same
# NISABA_SYNC_AUTHZ_TOKEN. The compose default (http://sync:8080) is usually
# right; only override for a non-standard sync address.
#NISABA_SYNC_STATE_URL=http://sync:8080
# App endpoint the sync service uses to verify a reviewer's seed of an empty
# document room against the authoritative body (reviewer overwrite protection).
# Unset = fail-closed: reviewer seeds are denied until an author connects.
NISABA_SYNC_SEED_VERIFY_URL=http://app:8080/internal/document
# The local stack uses HTTP on its private Docker networks. Production should
# omit this and use HTTPS endpoints.
NISABA_SYNC_HTTP_ALLOW_INSECURE_SCHEME=1

RUST_LOG=info,nisaba=debug
RUST_BACKTRACE=1

# Optional comma-separated hostnames accepted by the Vite development server
# when using a tunnel. Localhost and IP literals do not need to be listed.
# VITE_ALLOWED_HOSTS=example.trycloudflare.com

# -----------------------------------------------------------------------------
# Observability  (optional; see docs/operations.md)
# -----------------------------------------------------------------------------
# OTLP/gRPC collector endpoint. Leave empty to disable export.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAMESPACE=nisaba

# -----------------------------------------------------------------------------
# Backups  (see deploy/backup/ and docs/operations.md)
# -----------------------------------------------------------------------------
BACKUP_RETENTION_DAYS=7
BACKUP_LOCAL_DIR=./artifacts/backups
