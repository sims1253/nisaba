{
  "openapi": "3.1.0",
  "info": {
    "title": "Nisaba app service",
    "version": "0.1.0"
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "examples": [
                  "forbidden",
                  "not_found",
                  "conflict",
                  "bad_request",
                  "unauthorized",
                  "internal"
                ]
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "Project": {
        "type": "object",
        "required": [
          "id",
          "name",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ProjectCreate": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 1024
          }
        }
      },
      "ProjectPatch": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 1024
          }
        }
      },
      "Document": {
        "type": "object",
        "required": [
          "id",
          "project_id",
          "path",
          "title",
          "body",
          "data",
          "revision",
          "updated_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "project_id": {
            "type": "string",
            "format": "uuid"
          },
          "path": {
            "type": "string",
            "description": "Project-relative path, e.g. chapters/intro.typ",
            "maxLength": 1024
          },
          "title": {
            "type": "string",
            "maxLength": 2048
          },
          "body": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "revision": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "DocumentCreate": {
        "type": "object",
        "required": [
          "path",
          "title"
        ],
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 1024
          },
          "title": {
            "type": "string",
            "maxLength": 2048
          },
          "body": {
            "type": "string",
            "default": ""
          },
          "data": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "DocumentUpdate": {
        "type": "object",
        "properties": {
          "body": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "maxLength": 2048
          },
          "data": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "expected_revision": {
            "type": "integer",
            "format": "int64",
            "description": "Optimistic concurrency guard; a stale value returns 409"
          }
        }
      },
      "ProjectMembership": {
        "type": "object",
        "required": [
          "project_id",
          "subject",
          "role",
          "created_at"
        ],
        "properties": {
          "project_id": {
            "type": "string",
            "format": "uuid"
          },
          "subject": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "author",
              "reviewer",
              "read-only"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ProjectMemberCreate": {
        "type": "object",
        "required": [
          "subject",
          "role"
        ],
        "properties": {
          "subject": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "author",
              "reviewer",
              "read-only"
            ]
          }
        }
      },
      "ReferenceMetadata": {
        "type": "object",
        "required": [
          "title",
          "authors",
          "extra"
        ],
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 2048
          },
          "authors": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "string",
              "maxLength": 512
            }
          },
          "year": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          },
          "doi": {
            "type": "string",
            "maxLength": 512,
            "description": "Unique per project (case-insensitive)"
          },
          "pmid": {
            "type": "string",
            "maxLength": 128
          },
          "journal": {
            "type": "string",
            "maxLength": 1024
          },
          "extra": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "ReferenceMetadataPatch": {
        "type": "object",
        "description": "Partial metadata for PATCH; only supplied fields are merged. null clears year/doi/pmid/journal.",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 2048
          },
          "authors": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "string"
            }
          },
          "year": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 65535
          },
          "doi": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 512
          },
          "pmid": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 128
          },
          "journal": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1024
          },
          "extra": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "Provenance": {
        "type": "object",
        "properties": {
          "search": {
            "type": "string"
          },
          "database": {
            "type": "string"
          },
          "searched_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ReferenceEntry": {
        "type": "object",
        "required": [
          "id",
          "project_id",
          "metadata",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "project_id": {
            "type": "string",
            "format": "uuid"
          },
          "metadata": {
            "$ref": "#/components/schemas/ReferenceMetadata"
          },
          "provenance": {
            "$ref": "#/components/schemas/Provenance"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ReferenceCreate": {
        "type": "object",
        "required": [
          "metadata"
        ],
        "properties": {
          "metadata": {
            "$ref": "#/components/schemas/ReferenceMetadata"
          },
          "provenance": {
            "$ref": "#/components/schemas/Provenance"
          }
        }
      },
      "ReferencePatch": {
        "type": "object",
        "properties": {
          "metadata": {
            "$ref": "#/components/schemas/ReferenceMetadataPatch"
          },
          "provenance": {
            "$ref": "#/components/schemas/Provenance"
          }
        }
      },
      "FulltextInput": {
        "type": "object",
        "required": [
          "filename",
          "content_type",
          "size_bytes",
          "contents_base64"
        ],
        "properties": {
          "filename": {
            "type": "string"
          },
          "content_type": {
            "type": "string",
            "enum": [
              "application/pdf"
            ]
          },
          "size_bytes": {
            "type": "integer",
            "format": "int64"
          },
          "contents_base64": {
            "type": "string",
            "format": "byte",
            "description": "Base64-encoded PDF; must start with %PDF- and end with %%EOF"
          },
          "checksum_sha256": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "FulltextMetadata": {
        "type": "object",
        "required": [
          "reference_id",
          "blob_ref",
          "filename",
          "content_type",
          "size_bytes",
          "uploaded_at"
        ],
        "properties": {
          "reference_id": {
            "type": "string",
            "format": "uuid"
          },
          "blob_ref": {
            "type": "string"
          },
          "filename": {
            "type": "string"
          },
          "content_type": {
            "type": "string"
          },
          "size_bytes": {
            "type": "integer",
            "format": "int64"
          },
          "checksum_sha256": {
            "type": [
              "string",
              "null"
            ]
          },
          "uploaded_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ShareLinkCreate": {
        "type": "object",
        "required": [
          "role"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "author",
              "reviewer",
              "read-only"
            ]
          },
          "label": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "ShareLink": {
        "type": "object",
        "required": [
          "token_hash",
          "project_id",
          "role",
          "created_by",
          "created_at"
        ],
        "properties": {
          "token": {
            "type": "string",
            "description": "Plaintext token; empty on read responses"
          },
          "token_hash": {
            "type": "string"
          },
          "project_id": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "type": "string",
            "enum": [
              "author",
              "reviewer",
              "read-only"
            ]
          },
          "created_by": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "expires_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "label": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "RedeemResponse": {
        "type": "object",
        "required": [
          "project_id"
        ],
        "properties": {
          "project_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "MarkInput": {
        "type": "object",
        "required": [
          "start",
          "end",
          "kind",
          "author",
          "timestamp"
        ],
        "properties": {
          "id": {
            "type": [
              "integer",
              "null"
            ]
          },
          "start": {
            "type": "integer",
            "format": "int32"
          },
          "end": {
            "type": "integer",
            "format": "int32"
          },
          "kind": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "timestamp": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "CompileRequest": {
        "type": "object",
        "required": [
          "project_id",
          "entry",
          "sources",
          "view"
        ],
        "properties": {
          "project_id": {
            "type": "string",
            "format": "uuid"
          },
          "entry": {
            "type": "string",
            "description": "Entrypoint path; must exist in sources"
          },
          "sources": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Path \u2192 Typst source map"
          },
          "marks": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/MarkInput"
              }
            }
          },
          "view": {
            "type": "string",
            "enum": [
              "baseline",
              "proposed",
              "redline",
              "public"
            ]
          }
        }
      },
      "CompileResponse": {
        "type": "object",
        "required": [
          "build_id"
        ],
        "properties": {
          "pdf_base64": {
            "type": [
              "string",
              "null"
            ],
            "format": "byte"
          },
          "span_map": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "diagnostics": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "outline": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "build_id": {
            "type": "string"
          }
        }
      },
      "ExportRequest": {
        "type": "object",
        "required": [
          "entry",
          "view"
        ],
        "properties": {
          "entry": {
            "type": "string",
            "description": "A document path in this project; the archive always contains every document"
          },
          "view": {
            "type": "string",
            "enum": [
              "baseline",
              "proposed",
              "redline",
              "public"
            ]
          }
        }
      },
      "ExportResponse": {
        "type": "object",
        "required": [
          "compile",
          "references"
        ],
        "properties": {
          "compile": {
            "$ref": "#/components/schemas/CompileResponse"
          },
          "references": {
            "type": "object",
            "description": "Per-document RIS bibliographies with full-text attachments"
          },
          "zip_base64": {
            "type": [
              "string",
              "null"
            ],
            "format": "byte"
          },
          "zip_filename": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "AuditEvent": {
        "type": "object",
        "required": [
          "id",
          "project_id",
          "actor",
          "action",
          "resource_type",
          "resource_id",
          "at",
          "details"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "project_id": {
            "type": "string",
            "format": "uuid"
          },
          "actor": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "resource_type": {
            "type": "string"
          },
          "resource_id": {
            "type": "string",
            "format": "uuid"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "details": {
            "type": "object"
          }
        }
      }
    }
  },
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "healthz",
        "responses": {
          "200": {
            "description": "Liveness"
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "healthReady",
        "responses": {
          "200": {
            "description": "Readiness"
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "operationId": "openapi",
        "responses": {
          "200": {
            "description": "This document"
          }
        }
      }
    },
    "/projects": {
      "get": {
        "operationId": "listProjects",
        "responses": {
          "200": {
            "description": "Projects the caller is a member of",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Project"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createProject",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProjectCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Project"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/projects/{project_id}": {
      "get": {
        "operationId": "getProject",
        "responses": {
          "200": {
            "description": "Project",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Project"
                }
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "updateProject",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProjectPatch"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated project",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Project"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteProject",
        "responses": {
          "204": {
            "description": "Deleted"
          }
        }
      }
    },
    "/projects/{project_id}/members": {
      "get": {
        "operationId": "listMembers",
        "responses": {
          "200": {
            "description": "Members",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ProjectMembership"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "addMember",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProjectMemberCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Added",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectMembership"
                }
              }
            }
          }
        }
      }
    },
    "/projects/{project_id}/members/{subject}": {
      "delete": {
        "operationId": "removeMember",
        "responses": {
          "204": {
            "description": "Removed"
          }
        }
      }
    },
    "/projects/{project_id}/membership": {
      "get": {
        "operationId": "getMyMembership",
        "responses": {
          "200": {
            "description": "Caller's membership",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectMembership"
                }
              }
            }
          }
        }
      }
    },
    "/projects/{project_id}/documents": {
      "get": {
        "operationId": "listDocuments",
        "responses": {
          "200": {
            "description": "Documents",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Document"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createDocument",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DocumentCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Document"
                }
              }
            }
          }
        }
      }
    },
    "/projects/{project_id}/documents/{document_id}": {
      "get": {
        "operationId": "getDocument",
        "responses": {
          "200": {
            "description": "Document",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Document"
                }
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "updateDocument",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DocumentUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated document",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Document"
                }
              }
            }
          },
          "409": {
            "description": "Revision conflict"
          }
        }
      },
      "delete": {
        "operationId": "deleteDocument",
        "responses": {
          "204": {
            "description": "Deleted"
          }
        }
      }
    },
    "/projects/{project_id}/documents/{document_id}/history": {
      "get": {
        "operationId": "listDocumentHistory",
        "responses": {
          "200": {
            "description": "Revision list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/projects/{project_id}/documents/{document_id}/history/{revision_id}": {
      "get": {
        "operationId": "getDocumentRevision",
        "responses": {
          "200": {
            "description": "Revision",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/projects/{project_id}/references": {
      "get": {
        "operationId": "listReferences",
        "responses": {
          "200": {
            "description": "References",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ReferenceEntry"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
